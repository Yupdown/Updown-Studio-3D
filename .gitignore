# Help tools that honor '.gitignore' (redundant for Git itself).
/.git

/CMakeUserPresets.json

# Common build directories
/build*/

# Raytracing visual testbed output (scripts/rt-visual-test.ps1). Note the hyphen: the testbed's
# own sources live in /testbed/ and are tracked.
/testbed-*/

# Testbed scene assets, fetched by scripts/fetch-testbed-assets.ps1 (~54 MB of unmodified
# Khronos sample models).
/resource/model/sponza/
/resource/model/DamagedHelmet.glb

# Local CodeGraph index: a machine-specific SQLite database, rebuilt by `codegraph init`.
/.codegraph/

# CI jobs that run in symlinked trees produce these artifacts.
/real_work/
/work

# MacOS Finder files.
.DS_Store

# Python compile output.
*.pyc

# See Utilities/Sphinx/tutorial_archive.cmake
/Help/_generated

# CLion work directory
/.idea/
# CLion build directories
/cmake-build-*/

# QtCreator files.
/CMakeLists.txt.user*

# Visual Studio Code
/.vscode/
/.cache/

# Visual Studio work directory
/.vs/
# Visual Studio build directory
/out/

# clang-tidy output
/clang-tidy-fixes.patch